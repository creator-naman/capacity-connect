# ============================================================================
# CAPACITY CONNECT — environment configuration
#
# Copy to .env.local (gitignored) and fill in what you have.
#
#   NOTHING SET            → DEMO MODE (default)
#     Signed-cookie demo auth, disk-backed account registry (.data/),
#     browser-side demo catalog, and real local-disk file storage under
#     ./demo-uploads. The full product is demonstrable without a backend.
#
#   BOTH VARIABLES SET     → REAL SUPABASE MODE
#     Supabase Auth (email confirmation, password recovery, persistent
#     sessions), PostgreSQL via RLS-guarded queries, and the private
#     `resources` storage bucket. Run supabase/migrations/0001_init.sql first.
# ============================================================================

# ---- Public client configuration (safe to expose; guarded by RLS) ----------
# Project URL from Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key from Supabase → Settings → API. Safe for the browser:
# Row Level Security policies in the migration are the actual gate.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Optional ---------------------------------------------------------------
# Absolute site origin used in auth emails (password-recovery redirect).
# Example: http://localhost:3000 or https://capacity-connect.vercel.app
NEXT_PUBLIC_SITE_URL=

# ---- NEVER SET IN THIS APP -------------------------------------------------
# The SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security entirely.
# Capacity Connect deliberately never uses it — the anon key + RLS policies
# do all authorization work. If you ever add server-side jobs that need it,
# keep it server-only, never prefix it with NEXT_PUBLIC_, and never import
# it from client components.
